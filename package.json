{
  "name": "dsh-deterministic-tools",
  "version": "0.1.6",
  "description": "DSH plugin: 29 deterministic, offline tools for JSON validation with exact line/column, JSONPath queries, YAML/CSV conversion, text diff, regex capture, encodings, hashes, Unicode, CIDR, JWT structure and timestamps. Every call returns a { result, meta } receipt; over-budget input is refused, not truncated.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke-built.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax2/dsh-deterministic-tools.git"
  },
  "homepage": "https://zicode.com/software/",
  "bugs": {
    "url": "https://github.com/ax2/dsh-deterministic-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "deterministic",
    "offline",
    "local-first",
    "no-network",
    "read-only",
    "developer-tools",
    "agent-tools",
    "tool-calling",
    "json",
    "json-validate",
    "jsonpath",
    "yaml",
    "csv",
    "diff",
    "text-diff",
    "regex",
    "unicode",
    "encoding",
    "base64",
    "hex",
    "url",
    "hash",
    "sha256",
    "cidr",
    "jwt",
    "timestamp",
    "color",
    "receipt"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
